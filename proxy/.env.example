# Copy to proxy/.env and fill in. NEVER commit .env.
PORT=8787

# --- Image provider (MVP: Recraft V3, turnkey named-style lock) ---
# Leave blank to use the STUB provider (returns placeholder refs, no cost).
RECRAFT_API_KEY=
RECRAFT_BASE_URL=https://external.api.recraft.ai/v1

# --- LLM provider (prose + bible maintenance) ---
# Leave blank to use the STUB provider.
LLM_API_KEY=
# Model id (defaults to claude-haiku-4-5 when blank).
LLM_MODEL=
# Base URL for the Anthropic Messages API. Leave blank to use Anthropic's
# default host (https://api.anthropic.com). Point at a local shim to test.
LLM_BASE_URL=

# --- Abuse layer 3: global spend kill-switch ---
# Hard ceiling on total generations per day across ALL devices.
GLOBAL_DAILY_GENERATION_CAP=500

# --- Abuse layer 2: per-device free quota (free MVP) ---
FREE_BOOKS_PER_DEVICE=20

# --- Abuse layer 1: app attestation ---
# Apple App Attest + Google Play Integrity config goes here later.
APPLE_APP_ATTEST_TEAM_ID=
GOOGLE_PLAY_INTEGRITY_PROJECT=
# When true, requests with an invalid/missing attestation are rejected.
# Keep false ONLY for local development.
ENFORCE_ATTESTATION=false
